# ==============================
# TradePilot OS — API Keys
# ==============================
# Copy ไฟล์นี้เป็น .env แล้วใส่ key จริง

# Qwen API (Alibaba DashScope)
# https://dashscope.aliyuncs.com
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus

# NewsAPI
# https://newsapi.org (Free: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./tradepilot.db
